# MikroTik SSH connection (for live data + remote log setup)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_password
MIKROTIK_PORT=22

# Syslog collector (runs on this machine or inside MikroTik container)
SYSLOG_HOST=0.0.0.0
SYSLOG_PORT=514
SYSLOG_MAX_LOGS=50000

# Web dashboard — open http://<MIKROTIK_IP>:8080 after install
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_SECRET_KEY=change-me-in-production
